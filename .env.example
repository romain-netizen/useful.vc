# Pooled Neon Postgres connection string. Keep this server-side only.
DATABASE_URL=postgresql://user:password@endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Local Node preview port. Cloudflare and Vercel provide their own runtime ports.
PORT=3000

# Private review application. Configure these as encrypted Vercel variables.
REVIEW_USER=reviewer
REVIEW_PASSWORD=replace-with-a-long-random-password
