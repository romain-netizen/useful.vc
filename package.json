{
  "name": "useful-vc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "check": "node --check directory-api.js && node --check server.js && node --check worker.js && node --check public/app.js",
    "dev:cloudflare": "wrangler dev",
    "deploy:cloudflare": "wrangler deploy",
    "deploy:cloudflare:dry-run": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}

